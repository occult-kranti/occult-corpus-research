{
  "manifest_version": 3,
  "name": "Wizard Forums Scraper",
  "version": "2.1.0",
  "description": "Full-board, rate-limited, session-based WizardForums archiver with posts, links, resources, and analysis-ready ZIP exports. Honors robots.txt and Content-Signal policy.",
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": ["https://wizardforums.com/*"],
  "action": { "default_popup": "popup/popup.html", "default_title": "Wizard Forums Scraper" },
  "background": { "service_worker": "background/sw.js" },
  "content_scripts": [
    {
      "matches": ["https://wizardforums.com/*"],
      "js": ["lib/xf-parse.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
